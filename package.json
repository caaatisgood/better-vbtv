{
  "name": "better-vbtv",
  "version": "1.3.0",
  "packageManager": "pnpm@9.12.1",
  "description": "Better VBTV — spoiler-free Volleyball World TV with keyboard controls and watch history",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caaatisgood/better-vbtv.git"
  },
  "homepage": "https://github.com/caaatisgood/better-vbtv#readme",
  "bugs": {
    "url": "https://github.com/caaatisgood/better-vbtv/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:firefox": "cross-env BROWSER=firefox vite dev",
    "start:firefox": "web-ext run --source-dir dist/firefox --start-url https://tv.volleyballworld.com",
    "typecheck": "tsc --noEmit",
    "build": "rimraf dist/chromium && vite build",
    "build:firefox": "rimraf dist/firefox && cross-env BROWSER=firefox vite build",
    "zip": "cd dist/chromium && bestzip ../better-vbtv-chromium.zip *",
    "zip:firefox": "cd dist/firefox && bestzip ../better-vbtv-firefox.zip *"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.9",
    "@types/node": "^22.18.0",
    "bestzip": "^3.0.1",
    "cross-env": "^10.1.0",
    "navigation-api-types": "^0.6.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-solid": "^2.11.14"
  },
  "dependencies": {
    "solid-js": "^1.9.15"
  }
}
